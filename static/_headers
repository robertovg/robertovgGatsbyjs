# Cache rules for Cloudflare Pages.
#
# Pages and other files without a hash in their name (HTML, chunk-manifest.json,
# favicons, sitemap, feeds) must always be revalidated, so a deploy is picked up
# on the next visit. Pages are served at URLs ending in "/".
#
# The JavaScript bundles (app-*, commons-*, component---*, path---*, layout-*)
# are revalidated too. Gatsby 1 names them with webpack's [chunkhash], which is
# not a hash of the final file: module ids can change between builds while the
# name stays the same. Caching them as immutable let Cloudflare keep serving an
# old commons-*.js after a deploy, which broke hydration and left every image on
# its blurred placeholder. Revalidating costs a 304 when nothing changed.
#
# Images under /static/ are named after their content, so they can be kept for
# a year.
#
# Rules that match the same URL are merged, so the groups must not overlap.

/
  Cache-Control: public, max-age=0, must-revalidate

/*/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/app-*
  Cache-Control: public, max-age=0, must-revalidate

/commons-*
  Cache-Control: public, max-age=0, must-revalidate

/component---*
  Cache-Control: public, max-age=0, must-revalidate

/path---*
  Cache-Control: public, max-age=0, must-revalidate

/layout-*
  Cache-Control: public, max-age=0, must-revalidate

/static/*
  Cache-Control: public, max-age=31536000, immutable
